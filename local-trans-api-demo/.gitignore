# Browser-uploaded media (local-only scratch; keep the directory tracked)
uploads/*
!uploads/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Frontend build output and dependencies (no trailing slash: node_modules may be a symlink)
frontend/dist
frontend/node_modules
